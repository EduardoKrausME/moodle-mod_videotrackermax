{{!
    @template mod_videotrackermax/heatmap
}}
<div class="videotrackermax-heatmap" role="img" aria-label="{{label}}">
    {{#buckets}}
        <span class="videotrackermax-heatmap__bucket"
              style="--vtm-intensity: {{intensity}}"
              title="{{title}}"
              data-bucket="{{bucket}}">
        </span>
    {{/buckets}}
</div>
<div class="d-flex justify-content-between small text-muted mt-1">
    <span>00:00</span>
    <span>{{endlabel}}</span>
</div>
